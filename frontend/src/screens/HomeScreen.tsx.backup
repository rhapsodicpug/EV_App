const HomeScreen: React.FC = () => {
  // Get authenticated user from auth context
  const { user } = useAuth();

  // State for geolocation
  const [userLocation, setUserLocation] = useState<{latitude: number, longitude: number} | null>(null);
  const [locationError, setLocationError] = useState<string | null>(null);

  // State for stations data
  const [stations, setStations] = useState<any[]>([]);
  const [stationsLoading, setStationsLoading] = useState(false);

  // State for segmented control
  const [activeSegment, setActiveSegment] = useState<'Nearby' | 'Favorites' | 'Recent'>('Nearby');

  // State for search
  const [searchQuery, setSearchQuery] = useState('');

  // Animation values for premium effects
  const heroAnim = useRef(new Animated.Value(0)).current;
  const bookingAnim = useRef(new Animated.Value(0)).current;
  const favoriteAnim = useRef(new Animated.Value(0)).current;
  const vehicleAnim = useRef(new Animated.Value(0)).current;
  const batteryCounter = useRef(new Animated.Value(0)).current;

  // Press feedback animations
  const heroScale = useRef(new Animated.Value(1)).current;
  const bookingScale = useRef(new Animated.Value(1)).current;
  const favoriteScale = useRef(new Animated.Value(1)).current;
  const vehicleScale = useRef(new Animated.Value(1)).current;

  // Animation values for staggered entrance
  const stationAnimations = stations.map(() => new Animated.Value(0));

  // Mock favorites and recent data
  const favoriteStations = stations.filter(station => station.distance && station.distance < 5); // Closer stations as favorites
  const recentStations = stations.slice(0, 3); // First 3 as recent

  // Get filtered stations based on active segment
  const getFilteredStations = () => {
    let filteredStations = [];
    switch (activeSegment) {
      case 'Nearby':
        filteredStations = stations;
        break;
      case 'Favorites':
        filteredStations = favoriteStations;
        break;
      case 'Recent':
        filteredStations = recentStations;
        break;
      default:
        filteredStations = stations;
    }

    // Apply search filter
    if (searchQuery.trim()) {
      filteredStations = filteredStations.filter(station =>
        station.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
        station.address.toLowerCase().includes(searchQuery.toLowerCase())
      );
    }

    return filteredStations;
  };

  // Group stations by distance for Nearby tab
  const groupStationsByDistance = (stations: any[]) => {
    if (activeSegment !== 'Nearby') return { all: stations };

    const groups = {
      'Under 1 km': [] as any[],
      '1-5 km': [] as any[],
      '5-10 km': [] as any[],
      'Over 10 km': [] as any[],
    };

    stations.forEach(station => {
      const distance = station.distance || 0;
      if (distance < 1) {
        groups['Under 1 km'].push(station);
      } else if (distance < 5) {
        groups['1-5 km'].push(station);
      } else if (distance < 10) {
        groups['5-10 km'].push(station);
      } else {
        groups['Over 10 km'].push(station);
      }
    });

    return groups;
  };

  // Get availability text and color
  const getAvailabilityInfo = (station: any) => {
    const available = station.available || station.charging_slots?.filter((slot: any) => slot.status === 'AVAILABLE').length || 0;
    const total = station.total || station.charging_slots?.length || 0;

    return {
      text: `${available}/${total} Available`,
      color: available > 0 ? '#32CD32' : '#F44336'
    };
  };

  // Get connector type icons
  const getConnectorIcons = (station: any) => {
    const slots = station.charging_slots || [];
    const uniqueTypes = [...new Set(slots.map((slot: any) => slot.connector_type))];

    return uniqueTypes.slice(0, 3); // Show max 3 connector types
  };

  // Function to get location name from coordinates
  const getLocationName = (lat: number, lng: number): string => {
    // Simple reverse geocoding for Mumbai area based on coordinates
    if (lat >= 19.15 && lat <= 19.18 && lng >= 72.95 && lng <= 72.97) {
      return "Mumbai, Maharashtra";
    } else if (lat >= 19.05 && lat <= 19.08 && lng >= 72.86 && lng <= 72.88) {
      return "Bandra Kurla Complex, Mumbai";
    } else if (lat >= 19.11 && lat <= 19.13 && lng >= 72.83 && lng <= 72.85) {
      return "Juhu, Mumbai";
    } else if (lat >= 19.09 && lat <= 19.11 && lng >= 72.82 && lng <= 72.84) {
      return "Andheri, Mumbai";
    } else if (lat >= 19.06 && lat <= 19.08 && lng >= 72.87 && lng <= 72.89) {
      return "Bandra, Mumbai";
    } else {
      return "Mumbai Area";
    }
  };

  // Mock upcoming booking data with Mumbai location
  const upcomingBooking = {
    id: 'booking-123',
    stationName: 'Mumbai Central EV Station',
    address: 'Mumbai Central Railway Station, Mumbai, Maharashtra 400008',
    dateTime: 'Today, 3:00 PM - 4:00 PM',
    status: 'confirmed'
  };

  // Get user's live geolocation
  useEffect(() => {
    const getLocation = async () => {
      try {
        // Request location permissions
        const { status } = await Location.requestForegroundPermissionsAsync();

        if (status !== 'granted') {
          setLocationError('Location permission denied');
          Alert.alert(
            'Location Permission Required',
            'Please enable location services to find nearby charging stations.',
            [{ text: 'OK' }]
          );
          return;
        }

        // Get current position
        const location = await Location.getCurrentPositionAsync({
          accuracy: Location.Accuracy.High,
        });

        const { latitude, longitude } = location.coords;
        setUserLocation({ latitude, longitude });
        setLocationError(null);

        console.log('User location:', { latitude, longitude });

      } catch (error) {
        console.error('Error getting location:', error);
        setLocationError('Unable to get location');
        Alert.alert(
          'Location Error',
          'Unable to get your location. Please check your location settings.',
          [{ text: 'OK' }]
        );
      }
    };

    getLocation();
  }, []);

  // Fetch stations when user location changes
  useEffect(() => {
    const fetchStations = async () => {
      if (!userLocation) return;

      try {
        setStationsLoading(true);

        // Fetch stations from backend API using the nearby endpoint
        const response = await fetch(
          `http://192.168.1.8:8000/stations/nearby/?latitude=${userLocation.latitude}&longitude=${userLocation.longitude}&max_distance_km=20`,
          {
            method: 'GET',
            headers: {
              'Content-Type': 'application/json',
            },
          }
        );

        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        const data = await response.json();
        console.log('Fetched stations:', data);

        // Update stations state with real data
        setStations(data.stations || data || []);

      } catch (error) {
        console.error('Error fetching stations:', error);
        // Fallback to mock data if API fails
        const mockStations = [
          {
            id: '1',
            name: 'City Center Hub',
            available: 3,
            total: 5,
            distance: 1.2,
            status: 'AVAILABLE'
          },
          {
            id: '2',
            name: 'Mall Charging Point',
            available: 1,
            total: 4,
            distance: 2.8,
            status: 'AVAILABLE'
          },
          {
            id: '3',
            name: 'Airport Terminal',
            available: 5,
            total: 6,
            distance: 4.5,
            status: 'AVAILABLE'
          }
