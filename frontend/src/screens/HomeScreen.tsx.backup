  };

  const handlePressOut = (scaleAnim: Animated.Value) => {
    Animated.spring(scaleAnim, {
      toValue: 1,
      useNativeDriver: true,
      tension: 400,
      friction: 3,
    }).start();
  };

  const handleMapPress = () => {
    console.log('Navigate to Map');
  };

  // Enhanced Station Card Component
  const StationCard = ({ station }: { station: any }) => {
    const availability = getAvailabilityInfo(station);
    const connectorTypes = getConnectorIcons(station);

  return (
          <TouchableOpacity
        style={styles.enhancedStationCard}
        onPress={() => console.log('Navigate to station:', station.name)}
        activeOpacity={0.7}
      >
        {/* Status Indicator Circle */}
        <View style={styles.statusIndicator}>
          <View style={[
            styles.statusCircle,
            {
              borderColor: availability.color,
              backgroundColor: availability.color + '20'
            }
          ]}>
            <Zap size={16} color={availability.color} />
            </View>
        </View>

        {/* Main Content */}
        <View style={styles.cardContent}>
          {/* Top Row - Name and Availability Badge */}
          <View style={styles.cardTopRow}>
            <Text style={styles.stationPrimaryName} numberOfLines={1}>
              {station.name}
        </Text>
            <View style={[
              styles.availabilityPill,
              { backgroundColor: availability.color + '20' }
            ]}>
              <Text style={[styles.availabilityPillText, { color: availability.color }]}>
                {availability.text}
        </Text>
            </View>
          </View>

          {/* Middle Row - Address and Distance */}
          <View style={styles.cardMiddleRow}>
            <Text style={styles.stationSecondaryText} numberOfLines={1}>
              {station.address || 'Address not available'}
                  </Text>
            <Text style={styles.stationDistanceText}>
              {station.distance ? `${station.distance} km` : 'Distance unavailable'}
          </Text>
      </View>

          {/* Bottom Row - Connector Types */}
          {connectorTypes.length > 0 && (
            <View style={styles.connectorTypesRow}>
              {connectorTypes.slice(0, 3).map((type, typeIndex) => (
                <View key={`${station.id}-${typeIndex}`} style={styles.connectorTypeBadge}>
                  <Text style={styles.connectorTypeText}>
                    {type === 'CCS' && '⚡ CCS'}
                    {type === 'Type 2' && '🔌 Type 2'}
                    {type === 'CHAdeMO' && '⚡ CHAdeMO'}
                    {type === 'Tesla' && '⚡ Tesla'}
                    {!['CCS', 'Type 2', 'CHAdeMO', 'Tesla'].includes(type) && `🔌 ${type}`}
        </Text>
                    </View>
              ))}
            </View>
          )}
        </View>
      </TouchableOpacity>
    );
  };

  const filteredStations = getFilteredStations();
  const stationGroups = groupStationsByDistance(filteredStations);

  // Check if user needs to log in
  if (!user) {
    return (
      <View style={styles.container}>
        <StatusBar barStyle="light-content" backgroundColor="#121212" />
        <View style={styles.authRequiredContainer}>
          <View style={styles.authRequiredContent}>
            <Text style={styles.authRequiredTitle}>Welcome to EV Charging</Text>
            <Text style={styles.authRequiredSubtitle}>
              Please log in to access your personalized dashboard and find nearby charging stations.
            </Text>
          <TouchableOpacity
              style={styles.loginButton}
              onPress={handleLoginAgain}
          >
              <Text style={styles.loginButtonText}>Log In</Text>
            </TouchableOpacity>
            </View>
        </View>
      </View>
    );
  }

  return (
    <View style={styles.container}>
      <ScrollView style={styles.scrollContainer} showsVerticalScrollIndicator={false}>
        <StatusBar barStyle="light-content" backgroundColor="#121212" />

      {/* Header */}
      <View style={styles.header}>
        <View style={styles.headerContent}>
          <View style={styles.greetingSection}>
            <Text style={styles.greetingText}>
              Welcome, {user?.name || 'User'}
            </Text>
            {userLocation && !locationError && (
              <Text style={styles.locationSuccess}>
                📍 {getLocationName(userLocation.latitude, userLocation.longitude)}
            </Text>
            )}
          </View>

          <TouchableOpacity
            style={styles.profileButton}
            onPress={handleProfilePress}
          >
            <View style={styles.profileAvatar}>
              <User size={24} color="#00A8FF" />
            </View>
          </TouchableOpacity>
        </View>
      </View>

      {/* Widget-Based Dashboard */}
      <View style={styles.dashboardContainer}>
        {/* Row 1: Hero Widget (Full Width) */}
        <Animated.View
          style={[
            styles.heroWidget,
            {
              opacity: heroAnim,
              transform: [
                {
                  scale: heroAnim.interpolate({
                    inputRange: [0, 1],
                    outputRange: [0.8, 1],
                  }),
                },
                { scale: heroScale },
              ],
            },
          ]}
        >
          <TouchableOpacity
            style={styles.heroWidgetTouchable}
            onPress={handleNearbySearch}
            onPressIn={() => handlePressIn(heroScale)}
            onPressOut={() => handlePressOut(heroScale)}
            activeOpacity={1}
          >
                      <View style={styles.heroIconContainer}>
              <Zap size={48} color="#00A8FF" />
            </View>
            <View style={styles.heroTextContainer}>
              <Text style={styles.heroTitle}>Find a Charger</Text>
              <Text style={styles.heroSubtitle}>Tap to search for nearby available stations</Text>
        </View>
            </TouchableOpacity>
        </Animated.View>

        {/* Row 2: Two Widgets Side by Side */}
        <View style={styles.widgetRow}>
          {/* Upcoming Booking Widget */}
          <Animated.View
            style={[
              styles.upcomingBookingWidget,
              {
                opacity: bookingAnim,
                transform: [
                  {
                    scale: bookingAnim.interpolate({
                      inputRange: [0, 1],
                      outputRange: [0.8, 1],
                    }),
                  },
                  { scale: bookingScale },
                ],
              },
            ]}
          >
            <TouchableOpacity
              style={styles.widgetTouchable}
              onPress={handleViewBookingDetails}
              onPressIn={() => handlePressIn(bookingScale)}
              onPressOut={() => handlePressOut(bookingScale)}
              activeOpacity={1}
            >
            <View style={styles.bookingHeader}>
              <Calendar size={20} color="#00A8FF" />
              <Text style={styles.bookingWidgetTitle}>Upcoming</Text>
                    </View>
            {upcomingBooking ? (
              <View style={styles.bookingDetails}>
                <Text style={styles.bookingStationName}>{upcomingBooking.stationName}</Text>
                <Text style={styles.bookingTime}>{upcomingBooking.dateTime}</Text>
                <Text style={styles.bookingConnector}>⚡ Type 2</Text>
                    </View>
            ) : (
              <Text style={styles.noBookingText}>No upcoming sessions</Text>
            )}
            </TouchableOpacity>
          </Animated.View>

          {/* Favorite Status Widget */}
          <Animated.View
            style={[
              styles.favoriteStatusWidget,
              {
                opacity: favoriteAnim,
                transform: [
                  {
                    scale: favoriteAnim.interpolate({
                      inputRange: [0, 1],
                      outputRange: [0.8, 1],
                    }),
                  },
                  { scale: favoriteScale },
                ],
              },
            ]}
          >
            <TouchableOpacity
              style={styles.widgetTouchable}
              onPress={() => console.log('View favorite station')}
              onPressIn={() => handlePressIn(favoriteScale)}
              onPressOut={() => handlePressOut(favoriteScale)}
              activeOpacity={1}
            >
              <View style={styles.favoriteHeader}>
                <Star size={16} color="#FFD700" />
                <Text style={styles.favoriteTitle}>Favorite</Text>
                </View>
              <View style={styles.favoriteStatus}>
                <Text style={styles.favoriteAvailability}>4/5</Text>
                <Text style={styles.favoriteStatusText}>Available</Text>
        </View>
              <Text style={styles.favoriteStationName}>Central Station</Text>
            </TouchableOpacity>
          </Animated.View>
          </View>

                {/* Row 3: Vehicle Status Widget */}
        <Animated.View
          style={[
            styles.vehicleStatusWidget,
            {
              opacity: vehicleAnim,
              transform: [
                {
                  scale: vehicleAnim.interpolate({
                    inputRange: [0, 1],
                    outputRange: [0.8, 1],
                  }),
                },
                { scale: vehicleScale },
              ],
            },
          ]}
        >
          <TouchableOpacity
            style={styles.widgetTouchable}
            onPress={() => console.log('View vehicle details')}
            onPressIn={() => handlePressIn(vehicleScale)}
            onPressOut={() => handlePressOut(vehicleScale)}
            activeOpacity={1}
          >
            <View style={styles.vehicleHeader}>
              <Car size={20} color="#00A8FF" />
              <Text style={styles.vehicleTitle}>Vehicle Status</Text>
                </View>
            <View style={styles.batteryContainer}>
              <View style={styles.batteryCircle}>
                <Animated.Text style={styles.batteryPercentage}>
                  {batteryCounter.interpolate({
                    inputRange: [0, 82],
                    outputRange: ['0%', '82%'],
                  })}
                </Animated.Text>
                  </View>
              <View style={styles.rangeInfo}>
                <Text style={styles.rangeText}>245 km</Text>
                <Text style={styles.rangeLabel}>Range</Text>
                </View>
              </View>
          </TouchableOpacity>
        </Animated.View>
      </View>
    </ScrollView>
    </View>
  );
};

