  };

  const handleViewBookingDetails = () => {
    console.log('View booking details');
  };

  // Press feedback animations
  const handlePressIn = (scaleAnim: Animated.Value) => {
    Animated.spring(scaleAnim, {
      toValue: 0.98,
      useNativeDriver: true,
      tension: 400,
      friction: 3,
