  const handleNearbySearch = () => {
    console.log('Nearby search - current location:', userLocation);
    if (!userLocation) {
      Alert.alert('Location Required', 'Please enable location services to find nearby stations.');
      return;
    }
    // TODO: Implement nearby search functionality
  };

  const handleLoginAgain = () => {
    Alert.alert(
      'Session Expired',
      'Your session has expired. Would you like to log in again?',
      [
        { text: 'Cancel', style: 'cancel' },
        {
          text: 'Login',
          onPress: () => {
            // This would navigate to login screen
            console.log('Navigate to login screen');
          }
