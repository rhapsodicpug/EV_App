// Helper function to format operating hours
const formatOperatingHours = (operatingHours: any): string => {
  if (typeof operatingHours === 'string') {
    return operatingHours;
  }
  if (typeof operatingHours === 'object' && operatingHours !== null) {
    // Check if it's 24/7
    const hours = Object.values(operatingHours);
    if (hours.every((hour: any) => hour === '00:00-23:59' || hour === '24/7')) {
      return '24/7';
    }
    // Return first day's hours as example
    const firstDay = Object.values(operatingHours)[0];
    return typeof firstDay === 'string' ? firstDay : 'Hours vary';
  }
  return 'Hours not available';
};

// Helper function to get station status color
const getStatusColor = (status: string) => {
  switch (status) {
    case 'AVAILABLE':
      return Colors.semantic.success;
    case 'OCCUPIED':
      return Colors.semantic.warning;
    case 'MAINTENANCE':
      return Colors.semantic.error;
    default:
      return Colors.neutral.gray[400];
  }
};

// Helper function to get status variant
const getStatusVariant = (status: string) => {
  switch (status) {
    case 'AVAILABLE':
      return 'success';
    case 'OCCUPIED':
      return 'warning';
    case 'MAINTENANCE':
      return 'error';
    default:
      return 'primary';
  }
};

// Helper functions for weather and personalization
const getWeatherIcon = (condition: string, colors: any) => {
  switch (condition) {
    case 'sunny':
      return <Sun size={24} color={colors.primary} />;
    case 'cloudy':
      return <Cloud size={24} color={colors.text.secondary} />;
    case 'rainy':
      return <CloudRain size={24} color={Colors.semantic.info} />;
    default:
      return <Sun size={24} color={colors.primary} />;
  }
};

const getGreeting = () => {
  const hour = new Date().getHours();
  if (hour < 12) return 'Good Morning';
  if (hour < 17) return 'Good Afternoon';
  return 'Good Evening';
};

const getUserName = (user: any) => {
  return user?.name || user?.email?.split('@')[0] || 'there';
};

const getTimeOfDay = () => {
  const hour = new Date().getHours();
  if (hour < 12) return 'morning';
  if (hour < 17) return 'afternoon';
  return 'evening';
};

