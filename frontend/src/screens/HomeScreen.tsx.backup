          toValue: 1,
          duration: 600,
          delay: index * 100, // Staggered delay
          useNativeDriver: true,
        })
      );
      Animated.stagger(50, animations).start();
    }
  }, [stations, stationsLoading, stationAnimations]);

  // Premium animation effects
  useEffect(() => {
    // Start entrance animations with stagger
    const entranceAnimations = [
      Animated.parallel([
        Animated.timing(heroAnim, {
          toValue: 1,
          duration: 600,
          useNativeDriver: true,
        }),
      ]),
      Animated.parallel([
        Animated.timing(bookingAnim, {
          toValue: 1,
          duration: 500,
          useNativeDriver: true,
        }),
      ]),
      Animated.parallel([
        Animated.timing(favoriteAnim, {
          toValue: 1,
          duration: 500,
          useNativeDriver: true,
        }),
      ]),
      Animated.parallel([
        Animated.timing(vehicleAnim, {
          toValue: 1,
