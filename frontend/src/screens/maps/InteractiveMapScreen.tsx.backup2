// Helper function to format operating hours
const formatOperatingHours = (operatingHours: any): string => {
  if (typeof operatingHours === 'string') {
    return operatingHours;
  }
  if (typeof operatingHours === 'object' && operatingHours !== null) {
    // Check if it's 24/7
    const hours = Object.values(operatingHours);
    if (hours.every((hour: any) => hour === '00:00-23:59' || hour === '24/7')) {
      return '24/7';
    }
    // Return first day's hours as example
    const firstDay = Object.values(operatingHours)[0];
    return typeof firstDay === 'string' ? firstDay : 'Hours vary';
  }
  return 'Hours not available';
};

// ==================== TYPES ====================
interface LocationCoordinates {
  latitude: number;
  longitude: number;
}

interface FilterOptions {
  status: 'all' | 'available' | 'limited' | 'full';
  chargerType: 'all' | 'AC_SLOW' | 'AC_FAST' | 'DC_FAST' | 'DC_ULTRA_FAST';
  maxDistance: number;
  priceRange: [number, number];
}

// Default Mumbai coordinates as fallback
const DEFAULT_LOCATION: LocationCoordinates = {
  latitude: 19.0760,
  longitude: 72.8777,
};

// ==================== COMPONENT ====================
type MapNavigationProp = StackNavigationProp<StationStackParamList, 'StationList'>;

const InteractiveMapScreen: React.FC = () => {
  const { colors } = useThemeColors();
  const navigation = useNavigation<MapNavigationProp>();

  // Dark theme colors matching login screen
  const themeColors = {
    background: '#121212',
    surface: '#1a1a1a',
    primary: '#00A8FF',
    text: {
      primary: '#ffffff',
      secondary: '#666666',
    },
    border: '#333333',
  };

  // Helper functions
  const getStationAvailability = (station: EVStation): string => {
    const availableSlots = station.charging_slots.filter(slot => slot.status === 'AVAILABLE');
    if (availableSlots.length === 0) return 'No slots';
    if (availableSlots.length <= 2) return `${availableSlots.length} slot${availableSlots.length === 1 ? '' : 's'}`;
    return `${availableSlots.length} slots`;
  };

  const recenterMap = () => {
    // This will be implemented when we integrate with the map component
    console.log('Recentering map to user location');
  };

  const handleViewDetails = (station: EVStation) => {
    setSelectedStation(null); // Close bottom sheet
    navigation.navigate('StationDetails', { station });
  };

  // No state management needed for coming soon placeholder

  // ==================== EFFECTS ====================
  useEffect(() => {
    // Animate on mount
    Animated.timing(fadeAnim, {
      toValue: 1,
      duration: 600,
      useNativeDriver: true,
    }).start();
  }, []);

  // ==================== RENDER ====================
  return (
        setCurrentLocation(location.coords);
        console.log('✅ Location obtained:', location.coords);
      } else {
        setLocationError('Unable to get current location. Using default location.');
        setCurrentLocation(DEFAULT_LOCATION);
      }
    } catch (error) {
      console.error('Error initializing map:', error);
      setLocationError('Error getting location. Using default location.');
      setCurrentLocation(DEFAULT_LOCATION);
    } finally {
      setIsLoading(false);
    }
  };

  const loadStations = async () => {
    try {
      setStationsLoading(true);
      setStationsError(null);
      
      const response = await apiService.getStations();
      setStations(response.stations || []);
      console.log('✅ Stations loaded:', response.stations?.length || 0);
    } catch (error: any) {
      console.error('Error loading stations:', error);
      
      // Enhanced error handling
      if (error.response?.status === 404) {
        setStationsError('No charging stations found in your area.');
      } else if (error.response?.status === 500) {
        setStationsError('Server error. Please try again later.');
      } else if (error.code === 'NETWORK_ERROR' || error.message?.includes('Network')) {
        setStationsError('Network error. Please check your internet connection.');
      } else {
        setStationsError('Failed to load charging stations. Please try again later.');
      }
    } finally {
      setStationsLoading(false);
    }
  };

  const onRefresh = useCallback(async () => {
    setRefreshing(true);
    await Promise.all([initializeMap(), loadStations()]);
    setRefreshing(false);
  }, []);

  const applyFilters = () => {
    let filtered = [...stations];

    // Apply search filter
    if (searchQuery.trim()) {
      filtered = filtered.filter(station =>
        station.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
        station.address.toLowerCase().includes(searchQuery.toLowerCase()) ||
        station.city.toLowerCase().includes(searchQuery.toLowerCase())
      );
    }

    // Apply status filter
    if (filters.status !== 'all') {
      filtered = filtered.filter(station => {
        const status = getStationStatus(station);
        return status === filters.status.toUpperCase();
      });
    }

    // Apply charger type filter
    if (filters.chargerType !== 'all') {
      filtered = filtered.filter(station =>
        station.charging_slots.some(slot => slot.charger_type === filters.chargerType)
      );
    }

    // Apply price range filter
    filtered = filtered.filter(station =>
      station.charging_slots.some(slot => 
        slot.price_per_kwh >= filters.priceRange[0] && 
        slot.price_per_kwh <= filters.priceRange[1]
      )
    );

    setFilteredStations(filtered);
  };

  const handleStationPress = (station: EVStation) => {
    setSelectedStation(station);
  };

  const handleBookNow = (station: EVStation) => {
    if (selectedStation) {
      navigation.navigate('BookingForm' as any, { 
        stationId: station.id,
        slotNumber: station.charging_slots.find(slot => slot.status === 'AVAILABLE')?.slot_number
      });
    }
  };

  const handleNavigate = (station: EVStation) => {
    Alert.alert('Coming Soon', 'Navigation functionality will be available in the next update!');
  };

  const handleCall = (station: EVStation) => {
    if (station.contact_number) {
      Alert.alert('Coming Soon', 'Call functionality will be available in the next update!');
    }
  };

  const getStationStatus = (station: EVStation) => {
    const availableSlots = station.charging_slots.filter(slot => slot.status === 'AVAILABLE');
    if (availableSlots.length === 0) return 'FULL';
    if (availableSlots.length <= 2) return 'LIMITED';
    return 'AVAILABLE';
  };

  const getStatusColor = (status: string) => {
    switch (status) {
      case 'AVAILABLE': return Colors.semantic.success;
      case 'LIMITED': return Colors.semantic.warning;
      case 'FULL': return Colors.semantic.error;
      default: return colors.border;
    }
  };

  const getStatusText = (status: string) => {
    switch (status) {
      case 'AVAILABLE': return 'Available';
      case 'LIMITED': return 'Limited';
      case 'FULL': return 'Full';
      default: return 'Unknown';
    }
  };

  const retryLocation = () => {
    initializeMap();
  };

  const retryStations = () => {
    loadStations();
  };

  const clearFilters = () => {
    setFilters({
      status: 'all',
      chargerType: 'all',
      maxDistance: 10,
      priceRange: [0, 50],
    });
    setSearchQuery('');
  };

  // ==================== RENDER ====================
  if (isLoading) {
    return (
      <ScreenWrapper
        title="Interactive Map"
        subtitle="Find charging stations near you"
        variant="default"
      >
        <Loading />
      </ScreenWrapper>
    );
  }

  return (
    <View style={styles.container}>
      {/* Animated Gradient Background */}
      <Animated.View
        style={[
          styles.gradientBackground,
          {
            opacity: fadeAnim,
            transform: [{ scale: fadeAnim.interpolate({
              inputRange: [0, 1],
              outputRange: [0.95, 1],
            })}],
          },
        ]}
      >
        <LinearGradient
          colors={['#1a1a2e', '#16213e', '#0f0f23', '#1a1a2e']}
          style={styles.gradient}
          start={{ x: 0, y: 0 }}
          end={{ x: 1, y: 1 }}
        >
          {/* Animated mesh overlay */}
          <Animated.View
            style={[
              styles.meshOverlay,
              {
                transform: [
                  {
                    translateX: fadeAnim.interpolate({
                      inputRange: [0, 1],
                      outputRange: [-50, 50],
                    }),
                  },
                  {
                    translateY: fadeAnim.interpolate({
                      inputRange: [0, 1],
                      outputRange: [50, -50],
                    }),
                  },
                ],
              },
            ]}
          >
            <View style={styles.meshPattern}>
              {Array.from({ length: 20 }).map((_, i) => (
                <View key={i} style={[styles.meshDot, { left: Math.random() * 100 + '%', top: Math.random() * 100 + '%' }]} />
              ))}
            </View>
          </Animated.View>
        </LinearGradient>
      </Animated.View>

      {/* Main Content */}
      <View style={styles.contentContainer}>
        {/* Status Bar Space */}
        <View style={{ height: 44 }} />

        {/* Centered Content */}
        <View style={styles.centerContent}>
          {/* Icon */}
          <View style={styles.iconContainer}>
            <Ionicons name="map" size={80} color="#e0e0e0" />
          </View>

          {/* Headline */}
          <Text style={styles.headline}>
            A Better Map is on the Way
          </Text>

          {/* Subheading */}
          <Text style={styles.subheading}>
            We're crafting a seamless, best-in-class mapping experience{'\n'}to help you find chargers instantly.
          </Text>
        </View>
      </View>






            


  );
};

