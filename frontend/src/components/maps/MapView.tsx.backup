/**
 * Premium Google Maps Component
 * Features: Dark theme, custom markers, callouts, clustering-ready
 */

import React, { useRef } from 'react';
import {
  View,
  StyleSheet,
  Text,
  Dimensions,
} from 'react-native';
import MapView, { Marker, PROVIDER_GOOGLE, Callout } from 'react-native-maps';
import { Ionicons } from '@expo/vector-icons';
import { EVStation } from '../../types/api';
import { MAP_CONFIG } from '../../constants/config';

interface MapViewProps {
  stations: EVStation[];
  currentLocation: {
    latitude: number;
    longitude: number;
  } | null;
  onStationPress: (station: EVStation) => void;
  onRecenter?: () => void;
}

const { width: screenWidth, height: screenHeight } = Dimensions.get('window');

// Dark map styling for Google Maps
const darkMapStyle = [
  {
    "elementType": "geometry",
    "stylers": [{"color": "#242f3e"}]
  },
  {
    "elementType": "labels.text.stroke",
    "stylers": [{"color": "#242f3e"}]
  },
  {
    "elementType": "labels.text.fill",
    "stylers": [{"color": "#746855"}]
  },
  {
    "featureType": "administrative.locality",
    "elementType": "labels.text.fill",
    "stylers": [{"color": "#d59563"}]
  },
  {
    "featureType": "poi",
    "elementType": "labels.text.fill",
    "stylers": [{"color": "#d59563"}]
  },
  {
    "featureType": "road",
    "elementType": "geometry",
    "stylers": [{"color": "#38414e"}]
  },
  {
    "featureType": "road",
    "elementType": "geometry.stroke",
    "stylers": [{"color": "#212a37"}]
  },
  {
    "featureType": "road.highway",
    "elementType": "geometry",
    "stylers": [{"color": "#746855"}]
  },
  {
    "featureType": "transit",
    "elementType": "geometry",
    "stylers": [{"color": "#2f3948"}]
  },
  {
    "featureType": "water",
    "elementType": "geometry",
    "stylers": [{"color": "#17263c"}]
  }
];

const MapViewComponent: React.FC<MapViewProps> = ({
  stations,
  currentLocation,
  onStationPress,
  onRecenter,
}) => {
  const { colors } = useThemeColors();
  const mapRef = useRef<MapView>(null);
  const [selectedStation, setSelectedStation] = useState<EVStation | null>(null);

  const getStationStatus = (station: EVStation) => {
    const availableSlots = station.charging_slots.filter(slot => slot.status === 'AVAILABLE');
    if (availableSlots.length === 0) return 'FULL';
    if (availableSlots.length <= 2) return 'LIMITED';
    return 'AVAILABLE';
  };

  const getStatusColor = (status: string) => {
    switch (status) {
      case 'AVAILABLE': return MAP_CONFIG.MARKER_COLORS.AVAILABLE;
      case 'LIMITED': return MAP_CONFIG.MARKER_COLORS.MAINTENANCE;
      case 'FULL': return MAP_CONFIG.MARKER_COLORS.OCCUPIED;
      default: return MAP_CONFIG.MARKER_COLORS.OFFLINE;
    }
  };

  const getStatusText = (status: string) => {
    switch (status) {
      case 'AVAILABLE': return 'Available';
      case 'LIMITED': return 'Limited';
      case 'FULL': return 'Full';
      default: return 'Unknown';
    }
  };

  // Clustering logic
  const createClusters = (stations: EVStation[]) => {
    const clusters: Array<{ center: { x: number, y: number }, stations: EVStation[], count: number }> = [];
    const processedStations = new Set<string>();

    stations.forEach((station, index) => {
      if (processedStations.has(station.id)) return;

      const cluster = {
        center: { x: 30 + (index % 4) * 80, y: 60 + Math.floor(index / 4) * 60 },
        stations: [station],
        count: 1
      };

      // Simple clustering: group stations that are close in the demo layout
      stations.forEach(otherStation => {
        if (otherStation.id !== station.id && !processedStations.has(otherStation.id)) {
          const otherIndex = stations.indexOf(otherStation);
          const otherX = 30 + (otherIndex % 4) * 80;
          const otherY = 60 + Math.floor(otherIndex / 4) * 60;

          // If within 100px, add to cluster
          if (Math.abs(cluster.center.x - otherX) < 100 && Math.abs(cluster.center.y - otherY) < 100) {
            cluster.stations.push(otherStation);
            cluster.count++;
            processedStations.add(otherStation.id);
          }
        }
      });

      processedStations.add(station.id);
      clusters.push(cluster);
    });

    return clusters;
  };

  const formatOperatingHours = (operatingHours: any): string => {
    if (typeof operatingHours === 'string') {
      return operatingHours;
    }
    if (typeof operatingHours === 'object' && operatingHours !== null) {
      const hours = Object.values(operatingHours);
      if (hours.every((hour: any) => hour === '00:00-23:59' || hour === '24/7')) {
        return '24/7';
      }
      const firstDay = Object.values(operatingHours)[0];
      return typeof firstDay === 'string' ? firstDay : 'Hours vary';
    }
    return 'Hours not available';
  };

  const handleStationPress = (station: EVStation) => {
    setSelectedStation(station);
    onStationPress(station);
  };

  const closeStationDetails = () => {
    setSelectedStation(null);
  };

  // Get initial region based on current location or default
  const getInitialRegion = () => {
    if (currentLocation) {
      return {
        latitude: currentLocation.latitude,
        longitude: currentLocation.longitude,
        latitudeDelta: 0.05,
        longitudeDelta: 0.05,
      };
    }
    return MAP_CONFIG.DEFAULT_REGION;
  };

  // Handle marker press
  const handleMarkerPress = (station: EVStation) => {
    setSelectedStation(station);
    onStationPress(station);
  };

  // Animate to user location
  const animateToUserLocation = () => {
    if (currentLocation && mapRef.current) {
      mapRef.current.animateToRegion({
        latitude: currentLocation.latitude,
        longitude: currentLocation.longitude,
        latitudeDelta: 0.01,
        longitudeDelta: 0.01,
      });
    }
  };

  return (
    <View style={styles.container}>
      <MapView
        ref={mapRef}
        provider={PROVIDER_GOOGLE}
        style={styles.map}
        customMapStyle={darkMapStyle}
        initialRegion={getInitialRegion()}
        showsUserLocation={true}
        showsMyLocationButton={false}
        showsCompass={false}
        showsScale={false}
        showsBuildings={false}
        showsTraffic={false}
        showsIndoors={false}
        rotateEnabled={true}
        zoomEnabled={true}
        scrollEnabled={true}
      >
        {/* Station Markers */}
        {stations.map((station) => {
          const status = getStationStatus(station);
          const statusColor = getStatusColor(status);
          const availableSlots = station.charging_slots.filter(slot => slot.status === 'AVAILABLE').length;
          const totalSlots = station.charging_slots.length;

          return (
            <Marker
              key={station.id}
              coordinate={{
                latitude: station.location.coordinates[1],
                longitude: station.location.coordinates[0],
              }}
              onPress={() => handleMarkerPress(station)}
              tracksViewChanges={false}
            >
              {/* Custom Marker View */}
              <View style={styles.customMarkerContainer}>
                {/* Outer ring with status color */}
                <View style={[styles.markerOuterRing, { borderColor: statusColor }]}>
                  {/* Inner circle */}
                  <View style={[styles.markerInnerCircle, { backgroundColor: statusColor + '40' }]}>
                    {/* Lightning bolt icon */}
                    <Ionicons name="flash" size={14} color={statusColor} />
                  </View>
                </View>

                {/* Availability indicator */}
                <View style={[styles.availabilityBadge, { backgroundColor: statusColor }]}>
                  <Text style={styles.availabilityText}>
                    {availableSlots}/{totalSlots}
                  </Text>
                </View>
              </View>

              {/* Callout with station info */}
              <Callout tooltip={true}>
                <View style={styles.calloutContainer}>
                  <Text style={styles.calloutTitle}>{station.name}</Text>
                  <Text style={styles.calloutAddress}>{station.address}</Text>
                  <Text style={[styles.calloutStatus, { color: statusColor }]}>
                    {availableSlots} of {totalSlots} available
                  </Text>
                </View>
              </Callout>
            </Marker>
          );
        })}
      </MapView>
    </View>
  );
          const status = getStationStatus(station);
          const statusColor = getStatusColor(status);
          const statusText = getStatusText(status);
          
          return (
            <TouchableOpacity
              key={station.id}
              style={[
                styles.stationItem, 
                { backgroundColor: colors.surface },
                selectedStation?.id === station.id && { 
                                      borderColor: colors.primary, 
                  borderWidth: 2 
                }
              ]}
              onPress={() => handleStationPress(station)}
            >
              <View style={styles.stationHeader}>
                <View style={styles.stationInfo}>
                  <Text style={[styles.stationName, { color: colors.text.primary }]}>
                    {station.name}
                  </Text>
                  <Text style={[styles.stationAddress, { color: colors.text.secondary }]}>
                    {station.address}
                  </Text>
                </View>
                <View style={[styles.statusBadge, { backgroundColor: statusColor }]}>
                  <Text style={[styles.statusText, { color: '#FFFFFF' }]}>
                    {statusText}
                  </Text>
                </View>
              </View>

              <View style={styles.stationDetails}>
                <View style={styles.detailRow}>
                  <Ionicons name="time" size={16} color={colors.text.secondary} />
                  <Text style={[styles.detailText, { color: colors.text.secondary }]}>
                    {formatOperatingHours(station.operating_hours)}
                  </Text>
                </View>
                <View style={styles.detailRow}>
                  <Ionicons name="flash" size={16} color={colors.text.secondary} />
                  <Text style={[styles.detailText, { color: colors.text.secondary }]}>
                    {station.charging_slots.length} slots • {station.charging_slots[0]?.price_per_kwh || 0}₹/kWh
                  </Text>
                </View>
                <View style={styles.detailRow}>
                  <Ionicons name="car" size={16} color={colors.text.secondary} />
                  <Text style={[styles.detailText, { color: colors.text.secondary }]}>
                    {station.charging_slots.map(slot => slot.charger_type).join(', ')}
                  </Text>
                </View>
              </View>

              {selectedStation?.id === station.id && (
                <View style={styles.stationActions}>
                  <TouchableOpacity 
                    style={[styles.actionButton, { backgroundColor: colors.primary }]}
                    onPress={() => {/* Handle book now */}}
                  >
                    <Ionicons name="calendar" size={16} color={Colors.neutral.white} />
                    <Text style={[styles.actionText, { color: Colors.neutral.white }]}>
                      Book Now
                    </Text>
                  </TouchableOpacity>
                  <TouchableOpacity 
                    style={[styles.actionButton, { backgroundColor: colors.secondary }]}
                    onPress={() => {/* Handle navigate */}}
                  >
                    <Ionicons name="navigate" size={16} color={Colors.neutral.white} />
                    <Text style={[styles.actionText, { color: Colors.neutral.white }]}>
                      Navigate
                    </Text>
                  </TouchableOpacity>
                  <TouchableOpacity 
                    style={[styles.actionButton, { backgroundColor: colors.secondary }]}
                    onPress={() => {/* Handle call */}}
                  >
                    <Ionicons name="call" size={16} color={Colors.neutral.white} />
                    <Text style={[styles.actionText, { color: Colors.neutral.white }]}>
                      Call
                    </Text>
                  </TouchableOpacity>
                </View>
              )}
            </TouchableOpacity>
          );
        })}
      </ScrollView>
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
  },
  map: {
    flex: 1,
  },
  customMarkerContainer: {
    alignItems: 'center',
  },
